# Змінні середовища сервера FRS PAD. Скопіюйте у .env і заповніть; .env не додається до Git.

# Перший адміністратор: створюється під час першого запуску, якщо облікових записів ще немає.
# Далі користувачі керуються на вкладці «Користувачі» або командою scripts/manage_users.py.
PAD_ADMIN_EMAIL=admin@example.com
PAD_ADMIN_PASSWORD=

# Ключ підпису JWT, не менше 32 байт:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Без нього ключ випадковий і після перезапуску сервера потрібно увійти знову.
PAD_JWT_SECRET=

# Ключ AES-256 для еталонів і записів набору даних (64 шістнадцяткові символи):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Без ключа еталони зберігаються лише в пам'яті сервера, форма запису набору даних недоступна.
PAD_DATASET_KEY=

# Рівень системного журналу: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Доступ з мережі: імена сервера через кому і сертифікат TLS (HTTPS і WSS)
PAD_ALLOWED_HOSTS=
PAD_SSL_CERTFILE=
PAD_SSL_KEYFILE=
